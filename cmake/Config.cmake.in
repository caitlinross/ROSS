@PACKAGE_INIT@

include(CMakePrintHelpers)

get_filename_component(ROSS_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)

set(ROSS_VERSION_MAJOR "@ROSS_VERSION_MAJOR@")
set(ROSS_VERSION_MINOR "@ROSS_VERSION_MINOR@")
set(ROSS_VERSION_PATCH "@ROSS_VERSION_PATCH@")

# This is true when the package is still in the build directory (not installed)
if(CMAKE_CURRENT_LIST_DIR STREQUAL "@ROSS_BINARY_DIR@")
  set(ROSS_PACKAGE_IN_BUILD TRUE)
endif()

cmake_print_variables(CMAKE_CURRENT_LIST_DIR)
if(ROSS_PACKAGE_IN_BUILD)
  include ( "${CMAKE_CURRENT_LIST_DIR}/core/ROSS-targets.cmake" )
else()
  include ( "${CMAKE_CURRENT_LIST_DIR}/ROSS-targets.cmake" )
endif()
